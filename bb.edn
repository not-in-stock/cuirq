{:min-bb-version "1.3.0"

 :paths ["scripts"]

 :tasks
 {;; Build C++ bridge
  build
  {:doc "Build C++ bridge library and Java classes"
   :task (do
           (println "Building C++ bridge...")
           (shell "cmake -B build -G Ninja -DCUIRQ_DEV_RELOAD=ON")
           (shell "cmake --build build")
           (println "C++ bridge built")

           (println "\n Compiling Java classes...")
           (shell "mkdir -p build/classes")
           (shell "javac --release 25 -d build/classes java/qml/QtThread.java java/qml/PanamaBridge.java")
           (println "Java classes compiled")
           (println "\n Build completed successfully"))}

  ;; Build C++ bridge for production (no hot-reload)
  build-release
  {:doc "Build C++ bridge without hot-reload (for bundling)"
   :task (do
           (println "Building C++ bridge (release, no hot-reload)...")
           (shell "cmake -B build -G Ninja -DCUIRQ_DEV_RELOAD=OFF")
           (shell "cmake --build build")
           (println "C++ bridge built (release)")

           (println "\n Compiling Java classes...")
           (shell "mkdir -p build/classes")
           (shell "javac --release 25 -d build/classes java/qml/QtThread.java java/qml/PanamaBridge.java")
           (println "Java classes compiled")
           (println "\n Release build completed successfully"))}

  ;; Clean build artifacts
  clean
  {:doc "Clean build artifacts"
   :task (do
           (println "Cleaning build directory...")
           (shell "rm -rf build")
           (println "Build directory cleaned"))}

  ;; Run example applications
  run
  {:doc "Run an example: bb run <example-name>"
   :override-builtin true
   :requires ([babashka.fs :as fs])
   :task (let [example (first *command-line-args*)
               examples-dir "examples"
               example-dir (str examples-dir "/" example)]
           (when-not example
             (println "Usage: bb run <example-name>")
             (println "\nAvailable examples:")
             (doseq [dir (fs/list-dir examples-dir)]
               (when (fs/directory? dir)
                 (println "  -" (fs/file-name dir))))
             (System/exit 1))

           (when-not (fs/exists? example-dir)
             (println (str "Error: Example '" example "' not found"))
             (System/exit 1))

           ;; Ensure C++ bridge is built
           (when-not (or (fs/exists? "build/lib/libqmlbridge.dylib")
                         (fs/exists? "build/lib/libqmlbridge.so"))
             (println "C++ bridge not found. Building...")
             (shell "bb build"))

           (println (str "Starting " example " example..."))
           (println "")

           ;; Run with absolute paths from project root
           (let [project-root (System/getProperty "user.dir")
                 lib-path (str project-root "/build/lib")
                 classes-path (str project-root "/build/classes")
                 os-name (System/getProperty "os.name")
                 is-macos (re-find (re-pattern "(?i)mac") os-name)
                 ;; macOS needs -XstartOnFirstThread for Qt GUI
                 macos-flag (if is-macos "-J-XstartOnFirstThread " "")
                 ;; Panama FFM needs native access
                 panama-flag "-J--enable-native-access=ALL-UNNAMED "]
             (shell {:dir example-dir}
                    (str "clj "
                         macos-flag
                         panama-flag
                         "-J-Djava.library.path=" lib-path " "
                         "-Sdeps '{:aliases {:bridge {:extra-paths [\"" classes-path "\"]}}}' "
                         "-M:run:bridge"))))}

  ;; QML tooling
  lint-qml
  {:doc "Lint QML files for file-manager example"
   :requires ([babashka.fs :as fs])
   :task (let [import-path (str (fs/parent (fs/which "qmlformat")) "/../lib/qt-6/qml")
               files (map str (fs/glob "examples/file-manager/resources" "*.qml"))]
           (apply shell "qmllint" "-I" import-path files))}

  format-qml
  {:doc "Format QML files for file-manager example"
   :requires ([babashka.fs :as fs])
   :task (let [files (map str (fs/glob "examples/file-manager/resources" "*.qml"))]
           (apply shell "qmlformat" "-i" files))}

  ;; Start nREPL server
  nrepl
  {:doc "Start nREPL server on port 7888"
   :task (shell "clj -M:dev -m nrepl.cmdline --port 7888 --middleware '[cider.nrepl/cider-middleware]'")}

  ;; AOT-compile Clojure namespaces for native-image
  aot
  {:doc "AOT-compile example for native-image: bb aot <example-name>"
   :requires ([babashka.fs :as fs])
   :task (let [example (or (first *command-line-args*) "counter")
               example-dir (str "examples/" example)
               main-ns (case example
                         "counter" "counter.core"
                         "file-manager" "file-manager.core"
                         (do (println (str "Unknown example: " example))
                             (System/exit 1)))]
           (when-not (fs/exists? example-dir)
             (println (str "Error: Example '" example "' not found"))
             (System/exit 1))

           (let [project-root (System/getProperty "user.dir")
                 lib-path (str project-root "/build/lib")
                 classes-path (str project-root "/build/classes")
                 aot-dir (str project-root "/build/aot/" example)]
             (fs/create-dirs aot-dir)
             (println (str "AOT-compiling " main-ns "..."))
             (println (str "Output: " aot-dir))
             (shell {:dir example-dir}
                    (str "clj "
                         "-J--enable-native-access=ALL-UNNAMED "
                         "-J-Djava.library.path=" lib-path " "
                         "-Sdeps '{:aliases {:bridge {:extra-paths [\"" classes-path "\" \"" aot-dir "\"]}}}' "
                         "-M:bridge "
                         "-e \"(binding [*compile-path* \\\"" aot-dir "\\\"] (compile (quote " main-ns ")))\""))
             (println "AOT compilation complete")
             (println (str "Classes: " (count (fs/glob aot-dir "**/*.class")) " files"))))}

  ;; Run with GraalVM tracing agent to collect native-image config
  trace
  {:doc "Run example with tracing agent: bb trace <example-name>"
   :requires ([babashka.fs :as fs])
   :task (let [example (or (first *command-line-args*) "counter")
               example-dir (str "examples/" example)]
           (when-not (fs/exists? example-dir)
             (println (str "Error: Example '" example "' not found"))
             (System/exit 1))

           (when-not (or (fs/exists? "build/lib/libqmlbridge.dylib")
                         (fs/exists? "build/lib/libqmlbridge.so"))
             (println "C++ bridge not found. Building...")
             (shell "bb build"))

           (let [project-root (System/getProperty "user.dir")
                 lib-path (str project-root "/build/lib")
                 classes-path (str project-root "/build/classes")
                 config-dir (str project-root "/config")
                 os-name (System/getProperty "os.name")
                 is-macos (re-find (re-pattern "(?i)mac") os-name)
                 macos-flag (if is-macos "-J-XstartOnFirstThread " "")
                 panama-flag "-J--enable-native-access=ALL-UNNAMED "
                 agent-flag (str "-J-agentlib:native-image-agent=config-merge-dir=" config-dir " ")]
             ;; Verify GraalVM is available (tracing agent requires it)
             (when-not (fs/which "native-image")
               (println "Error: native-image not found. Run inside 'nix develop'.")
               (System/exit 1))
             (println (str "Running " example " with tracing agent..."))
             (println (str "Config output: " config-dir))
             (println "Use the app normally, then close the window to finalize config.\n")
             (shell {:dir example-dir}
                    (str "clj "
                         macos-flag
                         panama-flag
                         agent-flag
                         "-J-Djava.library.path=" lib-path " "
                         "-Sdeps '{:aliases {:bridge {:extra-paths [\"" classes-path "\"]}}}' "
                         "-M:run:bridge"))))}

  ;; Build native binary with GraalVM native-image
  native
  {:doc "Build native binary: bb native <example-name>"
   :requires ([babashka.fs :as fs]
              [babashka.process :as p]
              [clojure.string :as str])
   :task (let [example (or (first *command-line-args*) "counter")
               example-dir (str "examples/" example)
               main-class (case example
                            "counter" "counter.core"
                            "file-manager" "file_manager.core"
                            (do (println (str "Unknown example: " example))
                                (System/exit 1)))]
           (when-not (fs/exists? example-dir)
             (println (str "Error: Example '" example "' not found"))
             (System/exit 1))
           (when-not (fs/which "native-image")
             (println "Error: native-image not found. Run inside 'nix develop'.")
             (System/exit 1))

           ;; Ensure AOT classes exist
           (let [project-root (System/getProperty "user.dir")
                 aot-dir (str project-root "/build/aot/" example)
                 classes-path (str project-root "/build/classes")
                 config-dir (str project-root "/config")
                 lib-path (str project-root "/build/lib")
                 output-dir (str project-root "/build/native")
                 output-bin (str output-dir "/cuirq-" example)]
             (when-not (fs/exists? aot-dir)
               (println "AOT classes not found. Run 'bb aot " example "' first.")
               (System/exit 1))
             (fs/create-dirs output-dir)

             ;; Get deps classpath from the example + graal-build-time from root :native-image alias
             (let [deps-cp (str/trim (:out (deref (p/process {:dir example-dir :out :string :err :inherit}
                                                              "clj" "-Spath"))))
                   graal-cp (str/trim (:out (deref (p/process {:dir project-root :out :string :err :inherit}
                                                               "clj" "-Sdeps" "{:deps {com.github.clj-easy/graal-build-time {:mvn/version \"1.0.5\"}}}" "-Spath"))))
                   ;; Full classpath: AOT classes + bridge classes + config + deps + graal-build-time
                   full-cp (str/join ":" [aot-dir classes-path config-dir deps-cp graal-cp])]

               (println (str "Building native binary for " example "..."))
               (println (str "Output: " output-bin))
               (println "")

               (shell (str "native-image "
                           "--no-fallback "
                           "-H:+ForeignAPISupport "
                           "--enable-native-access=ALL-UNNAMED "
                           "--features=clj_easy.graal_build_time.InitClojureClasses "
                           "-Djava.library.path=" lib-path " "
                           "-cp " full-cp " "
                           "-o " output-bin " "
                           main-class))

               (println "")
               (println (str "Native binary built: " output-bin))
               (let [size-mb (/ (fs/size (str output-bin)) 1048576.0)]
                 (println (str "Size: " (format "%.1f" size-mb) " MB"))))))}

  ;; Create macOS .app bundle
  bundle
  {:doc "Create macOS .app bundle: bb bundle <example-name>"
   :requires ([bundle])
   :task (let [example (or (first *command-line-args*) "file-manager")]
           (bundle/bundle! example))}

  ;; Development REPL with example loaded
  dev
  {:doc "Start development REPL with counter example: bb dev <example-name>"
   :requires ([babashka.fs :as fs])
   :task (let [example (or (first *command-line-args*) "counter")
               example-dir (str "examples/" example)]
           (when-not (fs/exists? example-dir)
             (println (str "Error: Example '" example "' not found"))
             (System/exit 1))

           (println (str "Starting REPL with " example " example loaded..."))

           (let [project-root (System/getProperty "user.dir")
                 lib-path (str project-root "/build/lib")
                 classes-path (str project-root "/build/classes")
                 os-name (System/getProperty "os.name")
                 is-macos (re-find (re-pattern "(?i)mac") os-name)
                 macos-flag (if is-macos "-J-XstartOnFirstThread " "")
                 panama-flag "-J--enable-native-access=ALL-UNNAMED "]
             (shell {:dir example-dir}
                    (str "clj "
                         macos-flag
                         panama-flag
                         "-J-Djava.library.path=" lib-path " "
                         "-Sdeps '{:aliases {:bridge {:extra-paths [\"" classes-path "\"]}}}' "
                         "-M:dev:bridge"))))}}}
